# Copy this file to .env and adjust values for your environment.
# .env is loaded by every script via scripts/bash/lib/common.sh (load_env).

# Name used for docker compose -p / container prefixing
PROJECT_NAME=docker-env-manager

# Path to the docker-compose file, relative to repo root
COMPOSE_FILE=docker/docker-compose.yml

# Seconds to wait for containers to report healthy before start.sh gives up
HEALTH_TIMEOUT=60
